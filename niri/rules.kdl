// Niri overview backdrop image
layer-rule {
    match namespace="awww-daemon-backdrop"
    place-within-backdrop true
}

// Background effect for all windows
window-rule {
    match app-id=r#".*"#

    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 2
    }
}

window-rule {
    match app-id=r"steam*"
    open-focused true
}

// Opacity for file managers and terminal
window-rule {
    match app-id=r#"thunar"#
    match app-id=r#"nautilus"#
    match app-id=r#"Alacritty"#
    opacity 0.8

    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 2
    }
}

// Picture-in-picture: open floating
window-rule {
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    match app-id=r#"app.zen_browser.zen$"# title="^Picture-in-Picture$"
    match app-id=r#"brave-origin$"# title="^Picture-in-Picture$"

    open-floating true
}

// Browsers and editor: open maximized
window-rule {
    match app-id=r#"zen"#
    match app-id=r#"app.zen_browser.zen"#
    match app-id=r#"brave-origin"#
    match app-id=r#"helium-browser"#
    match app-id=r#"code"#
    open-maximized true
}

// xdg-desktop-portal-gtk / copyq: floating popup
window-rule {
    match app-id=r#"xdg-desktop-portal-gtk"#
    match app-id=r#"copyq"#
    match app-id=r#"blueman"#

    open-floating true
    default-floating-position x=660 y=240
    min-width 400
    min-height 600
}

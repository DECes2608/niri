// DO NOT EDIT THIS FILE, EDIT ~/hakuspace-control/niri-custom.kdl INSTEAD

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Custom script launchers
    Mod+L            hotkey-overlay-title="Adjust Brightness" { spawn "sh" "-c" "$HOME/.local/bin/nightlight_toggle.sh"; }
    Mod+X            hotkey-overlay-title="powermenu: rofi" { spawn "sh" "-c" "~/.config/rofi/scripts/powermenu.sh"; }
    Mod+V            hotkey-overlay-title="Clipboard: copyq" { spawn "copyq" "show"; }
    Mod+C            hotkey-overlay-title="Configs: nvim" { spawn "sh" "-c" "~/.config/rofi/scripts/config.sh"; }
    Mod+Y            hotkey-overlay-title="Wallpaper Select" { spawn "sh" "-c" "$HOME/.local/bin/wallpaper_select.sh"; }
    Mod+K            hotkey-overlay-title="Kitap Select" { spawn "sh" "-c" "$HOME/.local/bin/kitap-select.sh"; }
    Mod+M            hotkey-overlay-title="Music: Ncspot" { spawn "alacritty" "-e" "ncspot"; }
    Mod+R            hotkey-overlay-title="Radio: shortwave" { spawn "shortwave"; }
    Mod+Shift+M      hotkey-overlay-title="Mpv: lollypop" { spawn "lollypop"; }
    Mod+Shift+C      hotkey-overlay-title="Code: VScode" { spawn "code"; }
    Mod+Shift+S      hotkey-overlay-title="Open Games: Steam" { spawn "steam"; }
    Mod+Return       hotkey-overlay-title="Open a Terminal: alacritty" { spawn "alacritty"; }
    Mod+O            hotkey-overlay-title="Notes: Obsidian" { spawn "obsidian"; }
    Mod+D            hotkey-overlay-title="Run Application Menu: rofi" { spawn "rofi" "-show" "drun"; }
    Mod+E            hotkey-overlay-title="Open File Manager: thunar" { spawn "thunar"; }
    Mod+Shift+D      hotkey-overlay-title="Communication: Discord" { spawn "discord"; }
    Mod+B            hotkey-overlay-title="Open Browser: helium-browser" { spawn "helium-browser"; }
    Mod+Slash        hotkey-overlay-title="Open Emoji Menu" { spawn "rofi" "-modi" "emoji" "-show" "emoji"; }
    Mod+F6           { spawn "~/.local/bin/autoclicker-toggle.sh"; }
    Mod+F5           { spawn "~/.local/bin/autoclick.sh"; }

    // Screenshots
    Print           { screenshot; }
    Ctrl+Print      { screenshot-screen; }
    Alt+Print       { screenshot-window; }

    // Window management
    Mod+Q            repeat=false { close-window; }
    Mod+Space        { toggle-window-floating; }
    Mod+Grave        repeat=false { toggle-overview; }
    Mod+F            { maximize-column; }
    Mod+Shift+F      { fullscreen-window; }
    Mod+Alt+F        { maximize-window-to-edges; }
    Mod+Ctrl+F       { expand-column-to-available-width; }

    Mod+Left  { focus-column-left; }
    Mod+A     { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+S     { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    Mod+Ctrl+Left    { consume-or-expel-window-left; }
    Mod+Ctrl+Right   { consume-or-expel-window-right; }
    Mod+Ctrl+A       { consume-or-expel-window-left; }
    Mod+Ctrl+S       { consume-or-expel-window-right; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+period       { consume-window-into-column; }
    Mod+comma        { expel-window-from-column; }

    Mod+Home        { focus-column-first; }
    Mod+End         { focus-column-last; }
    Mod+Ctrl+Home   { move-column-to-first; }
    Mod+Ctrl+End    { move-column-to-last; }

    Mod+Shift+R      { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R       { reset-window-height; }

    Mod+T            { center-column; }
    Mod+Shift+T      { center-visible-columns; }

    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Mouse & touchpad wheels
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Workspace indices (1-9)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Audio - media controls
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    Mod+W                allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%-"; }
}

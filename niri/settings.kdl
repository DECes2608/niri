overview {
    zoom 0.6
    backdrop-color "#262626"
}

cursor {
    xcursor-theme "skr"
    xcursor-size 24
}

layout {
    gaps 2
    center-focused-column "always"

    preset-column-widths {
        proportion 0.5
        proportion 0.65
        proportion 0.8
        proportion 1.0
    }

    default-column-width {
        proportion 0.5
    }

    focus-ring {
        off
    }

    border {
        off
        width 2
    }

    shadow {
        off
        draw-behind-window true
        softness 30
        spread 5
        offset x=5 y=10
        color "#0007"
    }

    tab-indicator {
        on
        hide-when-single-tab
        place-within-column
        gap 10
        width 4
        length total-proportion=1.0
        position "right"
        gaps-between-tabs 4
        corner-radius 16
        active-color "red"
        inactive-color "gray"
        urgent-color "blue"
    }
}

gestures {
    dnd-edge-view-scroll {
        trigger-width 30
        delay-ms 100
        max-speed 1500
    }

    dnd-edge-workspace-switch {
        trigger-height 50
        delay-ms 100
        max-speed 1500
    }

    hot-corners {
        top-left
    }
}

input {
   focus-follows-mouse max-scroll-amount="0%"

    keyboard {
        xkb {
            layout "tr"
        }
        repeat-rate 35
        repeat-delay 250
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
    }

    trackpoint {
    }
}
